# hil-review 실험 장치 고정 이름 (USB 포트를 바꿔 꽂아도 같은 이름 유지)
# 설치:  sudo cp configs/udev/99-hil-review.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# 확인:  ls -l /dev/so101_* /dev/cam_*
#
# 로봇 보드: CH343 (1a86:55d3), 보드마다 고유 시리얼 번호로 구분 (2026-11-23, 리더 케이블을 뽑아 확인)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5AE6086427", SYMLINK+="so101_leader", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5AE6083026", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"

# 카메라: 두 대 모두 시리얼이 제조사 기본값(200901010001)으로 같아서 시리얼로는 구분 불가.
# 대신 제조사:모델 ID가 서로 달라서 그것으로 구분. 같은 모델을 한 대 더 달면 이 규칙은 쓸 수 없음.
# ATTR{index}=="0" = 영상 캡처 노드 (index1은 메타데이터 노드)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0825", ATTR{index}=="0", SYMLINK+="cam_front"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5844", ATTR{index}=="0", SYMLINK+="cam_wrist"
